HF_TOKEN=your_huggingface_token_here
HF_MODEL=your-road-model-id-here
# Get a token with inference permissions from
# https://huggingface.co/settings/tokens
# HF_MODEL should be a model repo id, e.g. username/model-name —
# a generic image classifier will recognize scenery but won't
# reliably detect Kerala flood/landslide conditions specifically;
# a fine-tuned model works much better here.
