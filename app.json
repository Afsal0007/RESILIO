{
  "expo": {
    "name": "RESILIO",
    "slug": "RESILIO",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "resilio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "RESILIO uses the camera to scan roads and report hazards.",
        "NSLocationWhenInUseUsageDescription": "RESILIO uses your location to show nearby camps, hazards, and SOS help, and to share your live position while you are on duty."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0ea5e9"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "RESILIO uses the camera to scan roads and report hazards."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RESILIO uses your location to show nearby camps, hazards, and SOS help, and to share your live position while you are on duty."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
