# Copy to .env and fill in a free Current Weather Data key from
# https://openweathermap.org/api
EXPO_PUBLIC_OWM_KEY=

# RoadScan AI server. Use http:// (uvicorn has no TLS). A physical phone
# cannot use localhost — that points at the phone itself. Use this
# computer's Wi-Fi LAN IP instead, for example:
# EXPO_PUBLIC_RESILIO_AI_URL=http://192.168.60.11:8000
# Same-computer web/emulator can use:
# EXPO_PUBLIC_RESILIO_AI_URL=http://localhost:8000
EXPO_PUBLIC_RESILIO_AI_URL=http://YOUR_COMPUTER_LAN_IP:8000
